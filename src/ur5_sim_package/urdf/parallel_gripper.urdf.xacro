<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="parallel_gripper"
               params="parent prefix:=''">

    <!-- ====================================================== -->
    <!-- UR5 dovetail adapter                                   -->
    <!-- ====================================================== -->
    <link name="${prefix}gripper_adapter_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh
            filename="package://ur5_sim_package/meshes/gripper/UR5_Dovetail_adapter.STL"
            scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}adapter_grey">
          <color rgba="0.35 0.35 0.35 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh
            filename="package://ur5_sim_package/meshes/gripper/UR5_Dovetail_adapter.STL"
            scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <mass value="0.25"/>
        <inertia
          ixx="0.00020"
          ixy="0.0"
          ixz="0.0"
          iyy="0.00020"
          iyz="0.0"
          izz="0.00020"/>
      </inertial>
    </link>
    <joint name="${prefix}tool_to_gripper_adapter"
           type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}gripper_adapter_link"/>
      <origin
        xyz="-0.0375 0.0375 0"
        rpy="1.5708 0 0"/>
    </joint>


    <!-- ====================================================== -->
    <!-- Main gripper body                                      -->
    <!-- ====================================================== -->
    <link name="${prefix}gripper_base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh
            filename="package://ur5_sim_package/meshes/gripper/Gripper_assembly_base.STL"
            scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}gripper_body">
          <color rgba="0.15 0.15 0.18 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh
            filename="package://ur5_sim_package/meshes/gripper/Gripper_assembly_base.STL"
            scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.035" rpy="0 0 0"/>
        <mass value="0.80"/>
        <inertia
          ixx="0.0025"
          ixy="0.0"
          ixz="0.0"
          iyy="0.0020"
          iyz="0.0"
          izz="0.0030"/>
      </inertial>
    </link>
    <joint name="${prefix}adapter_to_gripper_base"
           type="fixed">
      <parent link="${prefix}gripper_adapter_link"/>
      <child link="${prefix}gripper_base_link"/>
      <origin
        xyz="0.077 0.0142 0.0378 "
        rpy="-1.5708 -3.1416 0"/>
    </joint>


    <!-- ====================================================== -->
    <!-- Left moving finger                                     -->
    <!-- ====================================================== -->
    <link name="${prefix}left_finger_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh
            filename="package://ur5_sim_package/meshes/gripper/gripper_finger_assembly.STL"
            scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}left_finger_material">
          <color rgba="0.65 0.65 0.68 1.0"/>
        </material>
      </visual>
      <collision name="left_slider_collision">
        <origin xyz="0.0157 -0.065 0.0075" rpy="0 0 0"/>
        <geometry>
          <box size="0.0306 0.080 0.015"/>
        </geometry>
      </collision>
      <collision name="left_contact_pad">
        <origin xyz="0.0414 -0.01275 0.0785" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.0255 0.117"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.065" rpy="0 0 0"/>
        <mass value="0.20"/>
        <inertia
          ixx="0.00075"
          ixy="0.0"
          ixz="0.0"
          iyy="0.00050"
          iyz="0.0"
          izz="0.00060"/>
      </inertial>
    </link>
    <joint name="${prefix}left_finger_joint"
           type="prismatic">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}left_finger_link"/>
      <origin xyz="-0.00125 0.025 0.0686" rpy="0 0 0"/>
      <axis xyz="0 1 0"/> 
      <limit
        lower="0.0"
        upper="0.035"
        effort="50.0"
        velocity="0.08"/>
      <dynamics
        damping="2.0"
        friction="0.2"/> 
    </joint>


    <!-- ====================================================== -->
    <!-- Right mirrored moving finger                           -->
    <!-- ====================================================== -->
    <link name="${prefix}right_finger_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <!-- The same supplied finger STL is reused -->
          <mesh
            filename="package://ur5_sim_package/meshes/gripper/gripper_finger_assembly.STL"
            scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}right_finger_material">
          <color rgba="0.65 0.65 0.68 1.0"/>
        </material>
      </visual>
      <collision name="right_slider_collision">
        <origin xyz="0.0157 -0.065 0.0075" rpy="0 0 0"/>
        <geometry>
          <box size="0.0306 0.080 0.015"/>
        </geometry>
      </collision>
      <collision name="right_contact_pad">
        <origin xyz="0.0414 -0.01275 0.0785" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.0255 0.117"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.065" rpy="0 0 0"/>
        <mass value="0.20"/>
        <inertia
          ixx="0.00075"
          ixy="0.0"
          ixz="0.0"
          iyy="0.00050"
          iyz="0.0"
          izz="0.00060"/>
      </inertial>
    </link>
    <joint name="${prefix}right_finger_joint"
           type="prismatic">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}right_finger_link"/>
      <origin xyz="0.08129 -0.025 0.0687" rpy="0 0 3.14159265"/>
      <axis xyz="0 1 0"/>
      <limit
        lower="0.0"
        upper="0.035"
        effort="50.0"
        velocity="0.08"/>
      <dynamics
        damping="2.0"
        friction="0.2"/> 
      <!-- Mirror the left finger. -->
      <mimic
        joint="${prefix}left_finger_joint"
        multiplier="1.0"
        offset="0.0"/> 
    </joint>

    <!-- Keep the fingers in place until the controller starts. -->
    <gazebo reference="${prefix}left_finger_link">
      <gravity>false</gravity>
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
    </gazebo>
    <gazebo reference="${prefix}right_finger_link">
      <gravity>false</gravity>
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
    </gazebo>

    <!-- ====================================================== -->
    <!-- End-effector tool-centre-point frame                    -->
    <!-- ====================================================== -->
    <link name="${prefix}gripper_tcp"/>
    <joint name="${prefix}gripper_tcp_joint"
           type="fixed">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}gripper_tcp"/>
      <origin
        xyz="0 0 0.19"
        rpy="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>
