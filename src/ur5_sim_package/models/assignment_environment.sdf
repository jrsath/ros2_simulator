<?xml version="1.0"?>
<sdf version="1.7">
  <model name="assignment_environment">
    <static>true</static>

    <link name="ground">
      <pose>0 0 -0.015 0 0 0</pose>
      <collision name="ground_collision">
        <geometry>
          <box>
            <size>4.0 4.0 0.02</size>
          </box>
        </geometry>
      </collision>
      <visual name="ground_visual">
        <geometry>
          <box>
            <size>4.0 4.0 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.35 0.35 0.35 1.0</ambient>
          <diffuse>0.45 0.45 0.45 1.0</diffuse>
        </material>
      </visual>
    </link>

    <!-- Part F dimensions and pose: 20 cm x 20 cm x 80 cm,
         centred at x=0.5, y=0.0, z=0.4. -->
    <link name="pedestal_block">
      <pose>0.5 0.0 0.4 0 0 0</pose>
      <collision name="pedestal_collision">
        <geometry>
          <box>
            <size>0.2 0.2 0.8</size>
          </box>
        </geometry>
      </collision>
      <visual name="pedestal_visual">
        <geometry>
          <box>
            <size>0.2 0.2 0.8</size>
          </box>
        </geometry>
        <material>
          <ambient>0.25 0.35 0.65 1.0</ambient>
          <diffuse>0.30 0.45 0.80 1.0</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
