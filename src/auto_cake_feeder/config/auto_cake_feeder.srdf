<?xml version="1.0"?>
<robot name="auto_cake_feeder_ur5">
  <group name="ur_manipulator">
    <chain base_link="base_link" tip_link="gripper_tcp"/>
  </group>

  <group name="gripper">
    <joint name="left_finger_joint"/>
  </group>

  <group_state name="home" group="ur_manipulator">
    <joint name="shoulder_pan_joint" value="0.0"/>
    <joint name="shoulder_lift_joint" value="-1.2"/>
    <joint name="elbow_joint" value="-1.0"/>
    <joint name="wrist_1_joint" value="-1.2"/>
    <joint name="wrist_2_joint" value="-1.0"/>
    <joint name="wrist_3_joint" value="0.0"/>
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="left_finger_joint" value="0.035"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="left_finger_joint" value="0.0"/>
  </group_state>

  <end_effector name="bakery_gripper"
                parent_link="tool0"
                group="gripper"
                parent_group="ur_manipulator"/>

  <disable_collisions link1="base_link" link2="base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="arm_support_beam" link2="base_link" reason="Never"/>
  <disable_collisions link1="arm_support_beam" link2="base_link_inertia" reason="Never"/>
  <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="flange" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="gripper_adapter_link" reason="Never"/>
  <disable_collisions link1="flange" link2="gripper_adapter_link" reason="Never"/>
  <disable_collisions link1="tool0" link2="gripper_base_link" reason="Never"/>
  <disable_collisions link1="flange" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="gripper_adapter_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_adapter_link" link2="gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_adapter_link" link2="left_finger_link" reason="Never"/>
  <disable_collisions link1="gripper_adapter_link" link2="right_finger_link" reason="Never"/>
  <disable_collisions link1="gripper_base_link" link2="gripper_tcp" reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="right_finger_link" reason="Adjacent"/>
  <disable_collisions link1="left_finger_link" link2="right_finger_link" reason="Never"/>
</robot>
